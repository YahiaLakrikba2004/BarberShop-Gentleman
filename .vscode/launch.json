{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter (dev)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define-from-file=.dart_defines.json"
            ]
        },
        {
            "name": "Flutter Web (dev)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define-from-file=.dart_defines.json"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
