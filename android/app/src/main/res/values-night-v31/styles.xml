<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting on Android 12+ (Dark Mode) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- 
            ANDROID 12+ SPLASH SCREEN CONFIGURATION (DARK MODE)
            Forces solid black background and hides default icon
        -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        
        <!-- Hides the default App Icon on Splash Screen -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
